# Base de données PostgreSQL (fournie automatiquement par Railway)
DATABASE_URL="postgresql://brio:brio@localhost:5432/brio"

# Back-office : mot de passe d'accès à /admin et secret de signature des sessions
ADMIN_PASSWORD="changez-moi"
SESSION_SECRET="une-longue-chaine-aleatoire"

# URL publique du site (utilisée dans les emails et les retours Stripe)
APP_URL="http://localhost:3000"

# Fuseau horaire de la boutique (créneaux)
APP_TIMEZONE="Europe/Paris"

# Stripe (facultatif : sans clé, le paiement par carte est masqué)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Emails via SMTP (facultatif : sans SMTP_HOST, les emails sont seulement journalisés)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Biscotte <commandes@exemple.fr>"
